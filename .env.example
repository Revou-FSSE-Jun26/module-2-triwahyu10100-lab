# Copy this file to .env and fill in your local Postgres credentials.
# .env is gitignored and must never be committed.

SECRET_KEY=dev-secret-key-change-in-production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revoshop_db

# Secret used to sign/verify JWT access tokens (see POST /auth/login).
# Use a different, long random value in production — never reuse SECRET_KEY.
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production

